# .env.example — 이 파일을 .env로 복사한 뒤 값을 채운다
PG_HOST=127.0.0.1
PG_PORT=5433
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=<설치 때 정한 postgres 비밀번호>
PG_DB=account_protection
PG_TEST_DB=account_protection_test
AP_OWNER_PASSWORD=<임의 문자열>
AP_OPS_PASSWORD=<임의 문자열>
AP_GAME_PASSWORD=<임의 문자열>
AP_WEB_SECRET_KEY=<임의 문자열 50자 이상>
AP_WEB_OPERATOR_PASSWORD=<운영자 웹 로그인 초기 비밀번호>
